{
  "name": "ai-family-historian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24.4.1 <25"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.18"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present --workspace-concurrency=1 build",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test:unit": "vitest run tests/unit --maxWorkers=50%",
    "test:integration": "vitest run tests/integration --maxWorkers=50%",
    "test:e2e": "vitest run tests/e2e --maxWorkers=50%",
    "secret-scan": "sh scripts/secret-scan.sh",
    "security:check": "tsx tests/security/run.ts",
    "smoke": "tsx tests/smoke/run.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "ioredis": "6.0.0",
    "prettier": "3.9.6",
    "tsx": "4.23.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
